# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Portfolio Backend Configuration (Optional - frontend works standalone without these)
PORT=3000
JWT_SECRET="change-this-to-a-long-random-secret"
ADMIN_PASSWORD="talha-admin-2026"

# Optional MongoDB Atlas URI (defaults to local data/*.json if omitted)
MONGODB_URI=""

# Optional Nodemailer SMTP Settings for contact form email notifications
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
CONTACT_TO_EMAIL="talha8786815@gmail.com"
